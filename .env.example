# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
PROJECT_NAME="Enterprise Knowledge Assistant API"
ENVIRONMENT="development"          # development | staging | production
DEBUG=true
API_V1_PREFIX="/api/v1"

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST="0.0.0.0"
PORT=8000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL="INFO"                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=false

# ---------------------------------------------------------------------------
# CORS  (comma-separated list of origins)
# ---------------------------------------------------------------------------
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# ---------------------------------------------------------------------------
# PostgreSQL / SQLAlchemy
# ---------------------------------------------------------------------------
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="enterprise_knowledge"

# Optional: provide a full URL to override the components above.
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/enterprise_knowledge"

# ---------------------------------------------------------------------------
# Authentication / JWT
# ---------------------------------------------------------------------------
# Generate a strong key, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="CHANGE_ME_IN_PRODUCTION"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Vector store / embeddings
# ---------------------------------------------------------------------------
# Dimension of embedding vectors (1536 = OpenAI text-embedding-3-small).
EMBEDDING_DIM=1536

# ---------------------------------------------------------------------------
# File uploads
# ---------------------------------------------------------------------------
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=25
