# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
PROJECT_NAME="Enterprise Knowledge Assistant API"
ENVIRONMENT="development"          # development | staging | production
DEBUG=true
API_V1_PREFIX="/api/v1"

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST="0.0.0.0"
PORT=8000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL="INFO"                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=false

# ---------------------------------------------------------------------------
# CORS  (comma-separated list of origins)
# ---------------------------------------------------------------------------
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# ---------------------------------------------------------------------------
# PostgreSQL / SQLAlchemy
# ---------------------------------------------------------------------------
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="enterprise_knowledge"

# Optional: provide a full URL to override the components above.
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/enterprise_knowledge"

# ---------------------------------------------------------------------------
# Authentication / JWT
# ---------------------------------------------------------------------------
# Generate a strong key, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="CHANGE_ME_IN_PRODUCTION"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Vector store / embeddings
# ---------------------------------------------------------------------------
# Dimension of embedding vectors.
#   openai text-embedding-3-small = 1536
#   gemini text-embedding-004     = 768
#   ollama nomic-embed-text       = 768
EMBEDDING_DIM=1536

# Embedding provider: openai | gemini | ollama | fake
# "fake" produces deterministic local vectors and needs no API key, but is
# NON-SEMANTIC (random) — use a real provider for meaningful retrieval.
EMBEDDING_PROVIDER="fake"
EMBEDDING_MODEL="text-embedding-3-small"
# Required only when EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=""
# Required only when EMBEDDING_PROVIDER=gemini (set EMBEDDING_DIM=768)
GEMINI_API_KEY=""
# Ollama embeddings model (used when EMBEDDING_PROVIDER=ollama; set
# EMBEDDING_DIM=768 for nomic-embed-text). Reuses OLLAMA_BASE_URL below.
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# ---------------------------------------------------------------------------
# LLM (answer generation / agents)
# ---------------------------------------------------------------------------
# LLM provider: openai | gemini | ollama | fake
# "fake" returns deterministic, citation-aware text and needs no API key.
LLM_PROVIDER="fake"
LLM_MODEL="gpt-4o-mini"
LLM_TEMPERATURE=0.0

# Ollama (self-hosted / remote LLM runtime). Used only when LLM_PROVIDER=ollama.
# No API key required — just a reachable Ollama server URL.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_TIMEOUT=120

# ---------------------------------------------------------------------------
# RAG / chunking / retrieval
# ---------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RAG_TOP_K=5

# ---------------------------------------------------------------------------
# File uploads
# ---------------------------------------------------------------------------
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=25
